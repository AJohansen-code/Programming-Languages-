<program>    ::= <stmt>*
<stmt>       ::= <assignment> | <if_stmt> | <print_stmt>
<assignment> ::= <ident> "=" <expr>
<if_stmt>    ::= "if" <expr> "then" <stmt>*
<print_stmt> ::= "print" <expr>

<expr>       ::= <term> ( ("+" | "-") <term> )*
<term>       ::= <factor> ( ("*" | "/") <factor> )*
<factor>     ::= <ident> | <number> | "(" <expr> ")"

<ident>      ::= [a-zA-Z_][a-zA-Z0-9_]*
<number>     ::= [0-9]+