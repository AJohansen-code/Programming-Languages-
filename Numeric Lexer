def parse_numeric_token(s: str):
    """
    Examines the beginning of an input string and classifies it as: 
    INT, FLOAT, NEITHER, or ERROR.

    Return:
        tuple: (token_type, vaule, remaining_string) or just the status string depending 
                on assignment output formatting requirements.
    """

    if not s:
        return "NEITHER", None, ""

    if not s[0].isdigit():
        return "NEITHER", None, s

    operators = {"+", "-", "*", "/"}
    has_seen_decimal = False
    i = 0
    n = len(s)

    while i < n:
        char = s[i]

        if char.isdigit():
            i += 1
        elif char == ".":
            if has_seen_decimal:
                return "ERROR", None, s
            has_seen_decimal = True
            i += 1

        elif char.isalpha():
            return "ERROR", None, s
        elif char.isspace() or char in operators:
            break
        else:
            return "ERROR", None, s

        token_str = s[:i]


    if has_seen_decimal:
        parts = token_str.split(".")
        if len(parts) != 2 or len(parts[0]) == 0 or len(parts[1]) == 0:
            return "ERROR", None, s
        token_type = "FLOAT"
        token_value = float(token_str)
    else:
        token_type = "INT"
        token_value = int(token_str)

    remaining_idx = i
    while remaining_idx < n and s[remaining_idx].isspace():
        remaining_idx += 1

    remaining_str = s[remaining_idx:]

    return token_type, token_value, remaining_str


    def parse_and_print(s: str) -> None:
        """Helper function to match the prompt's exact expected output format."""
        print(f'Input: "{s}"')
        token_type, val, remaining = parse_numeric_token(s)

        if token_type in ("ERROR", "NEITHER"):
            print(f"Output: {token_type}\n")
        else:
            print(f'Output: ("{token_type}", {val})')
            print(f'Remaining: "{remaining}"\n')


    #Testing the behavior cases
    if __name__ == "__main__":
        test_cases = [
            "1231234asdf",
            "1231234 asdf",
            "123.1234asdf",
            "123.123.123",
            "123.1234+asdf",
            "+234",
            "asdf+asdf",
        ]

        for test in test_cases:
            parse_and_print(test)